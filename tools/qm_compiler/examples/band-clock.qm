      "value": null
    },
    {
      "op": "bind",
      "target": "do-alarm",
      "value": {
        "name": "do-alarm-clock",
        "tier": "sclerotic",
        "role": "band clock — bar boundaries on absolute deadlines, no model",
        "cost_per_call": 0,
        "latency_ms": 1,
        "plasticity": 0.05,
        "sheet_residue": {
          "measurements": {
            "boundaries_fired": "269/269 across two 5.5-minute production soaks",
            "worst_drift_ms": 1,
            "late_gt_100ms": 0,
            "catch_up_batches": 0,
            "pass_bar": "late-fire >100ms rate < 1%",
            "measured": "0.00%"
          }
        },
        "rule_count": 2
      }
    },
    {
      "op": "bind",
      "target": "do-alarm:facts",
      "value": {
        "name": "do-alarm-clock",
        "tier": "sclerotic",
        "role": "band clock — bar boundaries on absolute deadlines, no model",
        "cost_per_call": 0,
        "latency_ms": 1,
        "plasticity": 0.05,
        "sheet_residue": {
          "measurements": {
            "boundaries_fired": "269/269 across two 5.5-minute production soaks",
            "worst_drift_ms": 1,
