    },
    {
      "op": "bind",
      "target": "do-alarm:response",
      "value": null
    },
    {
      "op": "link",
      "from": "do-alarm",
      "to": "yard",
      "type": "lineage"
    },
    {
      "op": "link",
      "from": "yard",
      "to": "do-alarm",
      "type": "signal:bar-tick"
    },
    {
      "op": "effect",
      "target": "do-alarm:response",
      "guard": {
        "kind": "bar-tick"
      },
      "action": {
        "set": {
          "action": "freeze bar N+1 (final kind ok|shell|rest), set next alarm at startMs + N*barMs",
          "bar_ms": 2500,
          "tempo_bpm": 96,
          "meter": "4/4",
          "absolute_never_relative": true,
          "catch_up": "drain every due tick in order if a fire lands late",
          "model_call": false,
          "cost": 0
        }
      }
    },
    {
      "op": "effect",
      "target": "do-alarm:response",
      "guard": {
        "kind": "commit"
      },
      "action": {
        "set": {
          "action": "write pending bar blob, deadline-checked; tick N freezes bar N+1",
          "status": "pending -> frozen",
          "model_call": false,
          "cost": 0
        }
      }
    }
  ],
  "views": [
    {
      "name": "yard/facts",
      "target": "yard:facts",
